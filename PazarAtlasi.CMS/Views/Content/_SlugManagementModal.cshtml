<!-- Modal Overlay -->
<div id="slugManagementModal" class="fixed inset-0 bg-black bg-opacity-50 z-[10000] hidden items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden relative z-[10001]">

        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-purple-600 to-purple-700 px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                    <i id="modalIcon" class="fas fa-link text-white text-lg"></i>
                </div>
                <div>
                    <h3 id="modalTitle" class="text-xl font-bold text-white">Slug Yönetimi</h3>
                    <p id="modalSubtitle" class="text-purple-100 text-sm">Çoklu dil URL yapısını yönetin</p>
                </div>
            </div>
            <button onclick="closeSlugModal()" class="text-white hover:bg-white/20 rounded-lg p-2 transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 overflow-y-auto max-h-[calc(90vh-180px)]">

            <!-- Entity Selection Section -->
            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-6 border border-blue-100">
                <h4 class="text-sm font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-layer-group text-purple-600"></i>
                    Entity Seçimi
                </h4>

                <div class="grid grid-cols-2 gap-4">
                    <!-- Entity Type -->
                    <div>
                        <label for="entityType" class="block text-xs font-medium text-gray-700 mb-1.5">
                            <i class="fas fa-cube text-purple-500 mr-1"></i> Entity Tipi *
                        </label>
                        <select id="entityType" name="EntityType" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                            <option value="">Seçiniz...</option>
                        </select>
                    </div>

                    <!-- Entity Selection -->
                    <div>
                        <label for="entityId" class="block text-xs font-medium text-gray-700 mb-1.5">
                            <i class="fas fa-file text-purple-500 mr-1"></i> Entity *
                        </label>
                        <select id="entityId" name="EntityId" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                            <option value="">Önce entity tipi seçin...</option>
                        </select>
                        <div id="entityLoadingSpinner" class="hidden mt-1 text-xs text-gray-500">
                            <i class="fas fa-spinner fa-spin mr-1"></i> Yükleniyor...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Language Tabs -->
            <div class="mb-6">
                <div class="border-b border-gray-200">
                    <nav class="flex gap-2" id="languageTabs">
                        <!-- Tabs will be populated by JavaScript -->
                    </nav>
                </div>
            </div>

            <!-- Tab Content -->
            <div id="tabContents">
                <!-- Tab contents will be populated by JavaScript -->
            </div>

            <!-- Info Box -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mt-4">
                <div class="flex gap-2">
                    <i class="fas fa-info-circle text-blue-500 text-sm mt-0.5"></i>
                    <div class="text-xs text-blue-800">
                        <p class="font-semibold mb-0.5">Çoklu Dil Slug Yönetimi</p>
                        <p>Her dil için ayrı slug tanımlayabilirsiniz. Canonical URL, arama motorlarına hangi URL'nin asıl versiyon olduğunu belirtir.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-50 px-6 py-4 flex items-center justify-between border-t border-gray-200">
            <div class="text-sm text-gray-600">
                <i class="fas fa-lightbulb text-yellow-500 mr-1"></i>
                <span id="slugCount">0 dil için slug tanımlandı</span>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="closeSlugModal()" class="px-4 py-2 text-sm bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                    <i class="fas fa-times mr-1"></i> İptal
                </button>
                <button type="button" id="saveButton" onclick="saveAllSlugs()" class="px-4 py-2 text-sm bg-gradient-to-r from-purple-600 to-purple-700 text-white rounded-lg hover:from-purple-700 hover:to-purple-800 transition-all shadow-md hover:shadow-lg font-medium">
                    <i class="fas fa-save mr-1"></i> Tümünü Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .language-tab {
        padding: 0.75rem 1.5rem;
        border-bottom: 2px solid transparent;
        color: #6b7280;
        font-weight: 500;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .language-tab:hover {
        color: #9333ea;
        background-color: #faf5ff;
    }

    .language-tab.active {
        color: #9333ea;
        border-bottom-color: #9333ea;
        background-color: #faf5ff;
    }

    .language-tab .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: 10px;
        font-weight: 600;
    }

    .language-tab .badge.filled {
        background-color: #22c55e;
        color: white;
    }

    .language-tab .badge.empty {
        background-color: #e5e7eb;
        color: #6b7280;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
        animation: fadeIn 0.2s ease-in;
    }

</style>
